# Server Port
PORT=5000

# Environment (development / production / test)
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local mongodb://localhost:27017/liferpg)
# Leave blank or set USE_IN_MEMORY_DB=true to use automated in-memory MongoDB in dev
MONGODB_URI=mongodb://localhost:27017/liferpg
USE_IN_MEMORY_DB=false

# JWT Secret & Expiry
JWT_SECRET=super_secret_retro_life_rpg_key_2026!
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173
